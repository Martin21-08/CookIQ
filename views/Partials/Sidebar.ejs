<%# Menú compartido que enlaza con las páginas principales del sitio. %>
<% const accesoMasterChef = typeof planActual !== 'undefined' && planActual.masterchef; %>
<aside class="inicio-sidebar" data-masterchef="<%= Boolean(accesoMasterChef) %>">
  <div class="inicio-marca">
    <img src="/Img/54479.jpg" alt="Logo de CookIQ">
  </div>
  <% if (accesoMasterChef) { %>
    <span class="masterchef-distintivo" title="MasterChef activo"><%- include('iconoSuscripcion', { nombre: 'corona' }) %><span>MasterChef</span></span>
  <% } %>
      <nav class="inicio-menu">
        <a href="/lobby"><svg class="icono-menu" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16l-1.5 9h-13L4 11Z"/><path d="M7 11a5 5 0 0 1 10 0M2 8h3m14 0h3M12 2v2"/></svg><span>Cocinar</span></a>
        <a href="/despensa"><svg class="icono-menu" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9h18l-2 11H5L3 9Z"/><path d="M8 9a4 4 0 0 1 8 0M8 13v3m4-3v3m4-3v3"/></svg><span>Mi despensa <%- include('indicadorMasterChef', { disponible: Boolean(accesoMasterChef) }) %></span></a>
        <a href="/despensa#listaComprasMysql"><svg class="icono-menu" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h16v18H4ZM8 8h8M8 12h8M8 16h5"/></svg><span>Lista de compras <%- include('indicadorMasterChef', { disponible: Boolean(accesoMasterChef) }) %></span></a>
        <a href="/favoritos"><svg class="icono-menu" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.7c0 5.2-8.8 11-8.8 11S3.2 13.9 3.2 8.7A4.7 4.7 0 0 1 12 6.3a4.7 4.7 0 0 1 8.8 2.4Z"/></svg><span>Favoritos</span></a>
        <a href="/historial"><svg class="icono-menu" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 2.6-6.4L3 8"/><path d="M3 3v5h5m4-1v5l3 2"/></svg><span>Historial</span></a>
        <a href="/perfil"><svg class="icono-menu" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span>Perfil</span></a>
    </nav>
</aside>
<% if (accesoMasterChef && typeof success !== 'undefined' && success.includes('¡Compra realizada con éxito! 🎉 Tu suscripción MasterChef se ha activado correctamente. Ya puedes disfrutar de todos sus beneficios.')) { %>
  <%- include('bienvenidaMasterChef') %>
<% } %>
<script>
  // Oculta la instantánea privada y consulta otra vez al servidor al volver atrás.
  window.addEventListener('pagehide', evento => {
    if (evento.persisted) document.documentElement.style.visibility = 'hidden';
  });
  window.addEventListener('pageshow', evento => {
    if (evento.persisted) window.location.reload();
  });
</script>
