<%# Pantalla de acceso: correo y contraseña van a Express; Google usa Firebase. %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/Img/icono.png">
  <link rel="stylesheet" href="/Css/Style.css">
  <title>Iniciar sesión</title>
</head>
<body>
  <main class="modal-fondo login-con-volver">
    <a href="/" class="btn-login volver-descubre">← Volver a Descubre CookIQ</a>
    <%# Este formulario envía sus campos al controlador de usuarios para validarlos en MySQL. %>
    <form action="/usuarios/login" method="POST" class="modal-caja" id="formLogin">
      <div class="icono-cocina">
        <img src="/Img/54479.jpg" alt="Logo de CookIQ">
      </div>
      <h2>¡Hola de nuevo!</h2>
      <% if (error && error.length) { %><p class="mensaje-error" role="alert"><%= error.join(' ') %></p><% } %>
      <% if (success && success.length) { %><p class="mensaje-exito" role="status"><%= success.join(' ') %></p><% } %>
      <p class="subtitulo">Entra y sigue disfrutando de tus recetas.</p>

      <input type="email" name="correo" placeholder="Correo electrónico" aria-label="Correo electrónico" id="Usuario" required>

      <div class="campo-contrasena">
        <input type="password" name="password" placeholder="Contraseña" aria-label="Contraseña" id="Password" required>
        <button class="alternar-contrasena" type="button" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">
          <svg class="icono-ojo" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="icono-ojo-oculto" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A10.7 10.7 0 0 1 12 5c6.4 0 10 7 10 7a15.8 15.8 0 0 1-3.1 3.8M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10.4 10.4 0 0 0 3.2-.5"/></svg>
        </button>
      </div>

      <a href="/usuarios/recuperar" class="login-link">¿Olvidaste tu contraseña?</a>

      <button class="btn-login" type="submit" id="go">Entrar</button>

      <!-- Capa visual de CookIQ que acompaña la ventana externa de Google. -->
    <%- include('Partials/avisoGoogle') %>

      <a href="/usuarios/registro" class="registrar-link">¿No tienes cuenta? Regístrate</a>
    </form>

    <!-- Personalización común para cualquier método de inicio de sesión. -->
    <section class="modal-inicio" id="modalPersonalizacion" aria-hidden="true">
      <form class="modal-panel modal-registro-login" id="formPersonalizacion">
        <h2>¿Quieres personalizar tus alergias de una vez?</h2>
        <p>Selecciona lo que debemos considerar al recomendarte recetas.</p>
        <h3 class="perfil-subseccion">Alergias</h3>
        <div class="perfil-opciones">
          <label><input type="checkbox" name="alergias" value="Huevo"> Huevo</label>
          <label><input type="checkbox" name="alergias" value="Frutos secos"> Frutos secos</label>
          <label><input type="checkbox" name="alergias" value="Maní"> Maní</label>
          <label><input type="checkbox" name="alergias" value="Mariscos"> Mariscos</label>
          <label><input type="checkbox" name="alergias" value="Pescado"> Pescado</label>
          <label><input type="checkbox" name="alergias" value="Soja"> Soja</label>
        </div>
        <h3 class="perfil-subseccion">Intolerancias</h3>
        <div class="perfil-opciones">
          <label><input type="checkbox" name="intolerancias" value="Gluten"> Gluten</label>
          <label><input type="checkbox" name="intolerancias" value="Lactosa"> Lactosa</label>
          <label><input type="checkbox" name="intolerancias" value="Fructosa"> Fructosa</label>
          <label><input type="checkbox" name="intolerancias" value="Sorbitol"> Sorbitol</label>
        </div>
        <button class="boton-generar" type="submit">Guardar y entrar a la cocina</button>
      </form>
    </section>
  </main>
  <%- include('Partials/profile-onboarding') %>
  <script src="/Js/app.js"></script>
  <script type="module" src="/Js/firebase-auth.js"></script>
</body>
</html>

